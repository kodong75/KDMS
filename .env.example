# 사용법: cp .env.example .env 후 빈 값을 채운다. .env 는 커밋 금지(.gitignore).
# 값 뒤에 주석을 붙이지 않는다. 환경 변수가 같은 이름으로 있으면 환경 변수가 먼저다.

# ── 원천 MS-SQL 2019 (시험: 윈도우 노트북) ──
KDMS_SRC_HOST=192.168.0.12
KDMS_SRC_PORT=1433
KDMS_SRC_DB=KDMS_MOCK
KDMS_SRC_USER=kodong_ms
KDMS_SRC_PASSWORD=
# 시험 노트북은 자체 서명 인증서라 true. 운영은 false
KDMS_SRC_TRUST_CERT=true

# ── 대상 PostgreSQL 16 (시험: 노트북 Docker) ──
KDMS_TGT_HOST=192.168.0.12
KDMS_TGT_PORT=5432
KDMS_TGT_DB=kdms
KDMS_TGT_USER=kdms_app
KDMS_TGT_PASSWORD=
KDMS_TGT_SSLMODE=prefer
